ARG BASE_IMAGE=ubuntu:jammy

#---------------------------------------------------------------------
# BUILDER BASE IMAGE
#---------------------------------------------------------------------
FROM $BASE_IMAGE AS oai-flexric-base
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
       build-essential \
       libsctp-dev \
       git \
       tar \
       m4 \
       automake \
       libtool \
       cmake \
       bison \
       flex \
       libpcre2-dev \
       gcc-12 \
       g++-12 \
       ninja-build \
       ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# asn1c con soporte APER
RUN rm -rf /tmp/asn1c && \
    git clone https://github.com/mouse07410/asn1c /tmp/asn1c && \
    cd /tmp/asn1c && \
    git checkout 940dd5fa9f3917913fd487b13dfddfacd0ded06e && \
    autoreconf -iv && \
    ./configure --prefix /opt/asn1c/ && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/asn1c

#---------------------------------------------------------------------
# BUILDER STAGE
#---------------------------------------------------------------------
FROM oai-flexric-base AS oai-flexric-builder
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

ENV PATH="/opt/asn1c/bin:${PATH}"

WORKDIR /flexric
COPY . .

RUN rm -rf build && mkdir build && cd build && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DE2AP_VERSION=$E2AP_VERSION \
          -DKPM_VERSION=$KPM_VERSION \
          -DXAPP_MULTILANGUAGE=OFF \
          -DASN1C_EXEC_PATH=/opt/asn1c/bin/asn1c \
          -DCMAKE_C_COMPILER=gcc-12 \
          -DCMAKE_CXX_COMPILER=g++-12 .. && \
    ninja nearRT-RIC kpm_sm mac_sm rlc_sm pdcp_sm rc_sm tc_sm slice_sm gtp_sm ccc_sm && \
    mkdir -p /opt/flexric_install/usr/local/bin /opt/flexric_install/usr/local/lib/flexric && \
    find . -type f -name "nearRT-RIC" -exec cp {} /opt/flexric_install/usr/local/bin/ \; && \
    find src/sm/ -name "*_sm.so" -exec cp {} /opt/flexric_install/usr/local/lib/flexric/ \;

#---------------------------------------------------------------------
# TARGET IMAGE (LIVIANA)
#---------------------------------------------------------------------
FROM $BASE_IMAGE AS oai-flexric
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
       libsctp1 \
       libatomic1 \
       ca-certificates && \
    apt-get autoremove -y && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=oai-flexric-builder /opt/flexric_install/usr/local/ /usr/local/

RUN ldconfig

EXPOSE 36421/sctp
EXPOSE 36422/sctp
EXPOSE 36422/tcp

CMD ["nearRT-RIC", "-c", "/usr/local/etc/flexric/flexric.conf"]
